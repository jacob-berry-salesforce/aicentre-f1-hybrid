{
  "name": "@f1-sim/server",
  "version": "1.0.0",
  "description": "Local Node.js server for F1 Racing Simulator (PC 3)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
