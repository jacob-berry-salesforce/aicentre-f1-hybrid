{
  "name": "@f1-sim/rig-client",
  "version": "1.0.0",
  "description": "Background service for F1 simulator rigs (PC 1 & 2)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "install-service": "node dist/install-service.js",
    "uninstall-service": "node dist/uninstall-service.js"
  },
  "dependencies": {
    "socket.io-client": "^4.6.1",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "node-window-manager": "^2.2.4",
    "puppeteer": "^21.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "node-windows": "^1.0.0-beta.8"
  }
}
